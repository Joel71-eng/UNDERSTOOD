{
  "expo": {
    "name": "Understood",
    "slug": "understood-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gadjoel.understood",
      "infoPlist": {
        "NSCameraUsageDescription": "Understood uses the camera so the tutor can look at a textbook page, diagram, or lab setup you photograph and explain it."
      }
    },
    "android": {
      "package": "com.gadjoel.understood",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Understood uses the camera so the tutor can look at a textbook page, diagram, or lab setup you photograph and explain it."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "764543db-6466-4c42-8574-ad6fc88e1a54"
      }
    }
  }
}
